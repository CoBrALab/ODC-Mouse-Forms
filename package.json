{
  "name": "mouse-form-viewer",
  "homepage": "https://CoBrALab.github.io/ODC-Mouse-Forms/",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p src && vite build",
    "check": "pnpm lint:check && pnpm format:check && pnpm check-editions",
    "check-editions": "node scripts/check-edition-bumps.ts",
    "check-template": "node scripts/check-template-sync.ts",
    "dev": "vite",
    "format": "prettier --write lib scripts",
    "format:check": "prettier --check lib scripts",
    "lint": "tsc && eslint --fix lib scripts",
    "lint:check": "tsc && eslint lib scripts",
    "prepare": "husky",
    "preview": "vite preview",
    "setup-pages": "pnpm build && gh-pages -d dist"
  },
  "devDependencies": {
    "@douglasneuroinformatics/eslint-config": "^6.0.0",
    "@douglasneuroinformatics/prettier-config": "^0.3.0",
    "@douglasneuroinformatics/tsconfig": "^2.0.0",
    "@opendatacapture/instrument-guidelines": "^2.6.0",
    "@opendatacapture/playground-url": "^2.6.0",
    "@opendatacapture/serve-instrument": "^2.6.0",
    "@types/node": "^24.x",
    "@types/react": "19.x",
    "eslint": "^9.22.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "typescript": "6.0.x",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@opendatacapture/runtime-v1": "^2.6.0",
    "gh-pages": "^6.3.0",
    "lz-string": "^1.5.0"
  },
  "pnpm": {
    "overrides": {
      "picomatch@<2.3.2": "^2.3.2"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.34.3",
  "prettier": "@douglasneuroinformatics/prettier-config"
}
