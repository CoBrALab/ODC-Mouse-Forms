{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["@douglasneuroinformatics/tsconfig"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "ESNext"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "/runtime/v1/*": ["./node_modules/@opendatacapture/runtime-v1/dist/*"]
    },
    "types": ["@opendatacapture/runtime-v1/env", "node"]
  },
  "include": ["lib/**/*", "scripts/*"]
}
